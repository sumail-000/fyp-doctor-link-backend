{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/no-shows", "schedule": "0 2 * * *" },
    { "path": "/api/cron/reminders", "schedule": "0 8 * * *" }
  ]
}
